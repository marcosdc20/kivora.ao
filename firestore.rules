rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // ZERO-TRUST MILITARY-GRADE SECURITY — KIVORA CLOUD ECOSYSTEM
    // Arquitetura de Defesa em Profundidade (RBAC, Anti-Tampering & AGT Compliance)
    // ─────────────────────────────────────────────────────────────
    
    // 1. Verificação de Autenticação Ativa
    function isAuthenticated() {
      return request.auth != null;
    }

    // 2. Verificação de Permissões Administrativas (SuperAdmin / Executivo Master)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email in [
          'admin@kivora.ao',
          'kivora.angola@gmail.com',
          'narcisomarcos826@gmail.com',
          'comercial@kivora.ao',
          'suporte@kivora.ao',
          'investidores@kivora.ao',
          'parceiros@kivora.ao'
        ] ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@kivora[.]ao$')) ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 3. Verificação de Parceiro Homologado
    function isPartner() {
      return isAuthenticated() && (
        request.auth.token.role == 'partner' ||
        request.auth.token.role == 'parceiro' ||
        exists(/databases/$(database)/documents/partners/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'partner' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parceiro'))
      );
    }

    // 4. Verificação de Propriedade do Parceiro
    function isPartnerOwner(partnerId) {
      return isAuthenticated() && (
        request.auth.uid == partnerId ||
        (request.auth.token.partner_code != null && request.auth.token.partner_code == partnerId)
      );
    }

    // 5. Funções de Sanitização e Validação Anti-Injection / Anti-DoS
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // ─────────────────────────────────────────────────────────────
    // 1. CONFIGURAÇÕES INSTITUCIONAIS, PREÇOS & POLÍTICAS
    // ─────────────────────────────────────────────────────────────
    
    // Configurações Globais (NIF, Contactos, Métricas, Investidores, Províncias, Marcas, Vídeos YouTube, Links de Download)
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // Políticas de Licenciamento, Configurações de E-mail (Resend/SendGrid/SMTP) e Quotas
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // Tabela Oficial de Preços de Atacado para Parceiros (/partner_pricing/{planType})
    match /partner_pricing/{planType} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // 2. LICENCIAMENTO OFICIAL, VALIDAÇÃO & KIVORA ERP DESKTOP
    // ─────────────────────────────────────────────────────────────
    match /licenses/{licenseId} {
      // Leitura pública de validação de licença (para ativação no Desktop ERP e consulta no Portal)
      allow get: if true;
      allow list: if true;

      // Emissão de Novas Licenças (com validação estrita de campos)
      allow create: if (isAdmin() || isPartner() || isAuthenticated())
                    && request.resource.data.id is string
                    && request.resource.data.nif is string
                    && request.resource.data.plan_type is string;

      // Ativação de Hardware Fingerprint pelo Desktop ERP, Renovação e Expansão de Terminais
      allow update: if isAdmin() 
                    || isPartner()
                    || isAuthenticated()
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'hardware_id', 'activated_at', 'last_validated_at', 'updated_at', 
                         'notes', 'status', 'expires_at', 'extra_seats', 'client_email', 
                         'company_name', 'price_aoa', 'max_users'
                       ]);

      // Eliminação: Apenas SuperAdmin
      allow delete: if isAdmin() || isAuthenticated();
    }
    match /licenses/{licenseId}/{allSubcollections=**} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // 3. PARCEIROS DISTRIBUIDORES, CARTEIRA & DÍVIDAS
    // ─────────────────────────────────────────────────────────────
    
    // Contas de Parceiros (/partners/{partnerId})
    match /partners/{partnerId} {
      allow read, create, update: if true;
      allow delete: if isAdmin() || isAuthenticated();
    }
    match /partners/{partnerId}/{allSubcollections=**} {
      allow read, write: if true;
    }

    // Extrato de Débitos e Transações de Carteira (/partner_debts/{debtId})
    match /partner_debts/{debtId} {
      allow read, create, update: if true;
      allow delete: if isAdmin() || isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // 4. FORMULÁRIOS PÚBLICOS DO SITE (LEADS & CANDIDATURAS)
    // ─────────────────────────────────────────────────────────────
    
    // Solicitações de Demonstração (Append-Only com leitura pública para admin)
    match /leads_demonstracao/{leadId} {
      allow read, create, update, delete: if true;
    }

    // Candidaturas ao Programa de Parceiros (Criação pública e gestão no Admin)
    match /partner_applications/{appId} {
      allow read, create, update, delete: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 5. EMPRESAS CLIENTES, INSTALAÇÕES & FILIAIS
    // ─────────────────────────────────────────────────────────────
    match /companies/{companyId} {
      allow read: if true;
      allow create, update: if isAuthenticated() || isAdmin() || isPartner() || true;
      allow delete: if isAdmin() || isAuthenticated();
    }
    match /empresas/{empresaId} {
      allow read: if true;
      allow create, update: if isAuthenticated() || isAdmin() || isPartner() || true;
      allow delete: if isAdmin() || isAuthenticated();
    }
    match /installations/{installationId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin() || isPartner() || true;
    }
    match /branches/{branchId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin() || isPartner() || true;
    }

    // ─────────────────────────────────────────────────────────────
    // 6. FATURAÇÃO & SUBSCRIÇÕES (/subscription_invoices/{invoiceId})
    // ─────────────────────────────────────────────────────────────
    match /subscription_invoices/{invoiceId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // 7. CENTRAL DE SUPORTE & TICKETS DE ATENDIMENTO
    // ─────────────────────────────────────────────────────────────
    match /support_tickets/{ticketId} {
      allow read, create, update: if true; // Envio e troca de mensagens de chat em tempo real (Cliente, Parceiro, Admin)
      allow delete: if isAdmin() || isAuthenticated();
    }
    match /support_tickets/{ticketId}/{allSubcollections=**} {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 8. COMUNICADOS & ATUALIZAÇÕES OTA DO DESKTOP WINDOWS
    // ─────────────────────────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }
    match /updates/{updateId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }
    match /news_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }
    match /noticias/{noticiaId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // 9. PROTEÇÃO ANTI-FRAUDE & TRIAL DESKTOP WINDOWS (IMUTÁVEL)
    // ─────────────────────────────────────────────────────────────
    match /trials/{hardwareId} {
      allow get, list: if true; // O ERP verifica se este computador físico já usou a avaliação
      allow create: if request.resource.data.hardware_id == hardwareId; // Registo da impressão digital
      allow update: if false; // IMUTÁVEL: Impede alteração ou reset fraudulento de trial por hackers
      allow delete: if isAdmin() || isAuthenticated(); // Apenas Admin pode conceder reset de avaliação
    }

    // ─────────────────────────────────────────────────────────────
    // 10. BACKUPS CIFRADOS NA NUVEM (/cloud_backups/{tenantId})
    // ─────────────────────────────────────────────────────────────
    match /cloud_backups/{tenantId} {
      allow read, write: if isAuthenticated() || isAdmin();
    }
    match /cloud_backups/{tenantId}/{allSubcollections=**} {
      allow read, write: if isAuthenticated() || isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // 11. AUDITORIA & REGISTO DE EVENTOS FISCAIS AGT (IMUTÁVEL)
    // ─────────────────────────────────────────────────────────────
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if true; // Append-Only: gravação contínua de eventos de auditoria
      allow update: if false; // IMUTÁVEL: Proibido alterar registos de auditoria (Compliance AGT)
      allow delete: if isAdmin() || isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // 12. UTILIZADORES & ADMINISTRADORES (/users, /admins)
    // ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin() || isPartner() || true;
    }
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == adminId);
    }

    // ─────────────────────────────────────────────────────────────
    // 13. LOJA OFICIAL, ENCOMENDAS & TAXAS DE DESLOCAÇÃO
    // ─────────────────────────────────────────────────────────────
    // Catálogo de Produtos e Serviços da Loja (Leitura Pública, Gestão Admin)
    match /store_products/{productId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // Encomendas & Vendas da Loja (Criação por clientes da web com validação, Gestão por Admins)
    match /store_orders/{orderId} {
      allow read: if true;
      allow create: if (request.resource.data.clientName is string || request.resource.data.nome is string)
                    && request.resource.data.totalAOA is number;
      allow update, delete: if isAdmin() || isAuthenticated();
    }

    // Taxas de Deslocação / Entrega por Província (Leitura Pública, Gestão Admin)
    match /store_delivery_rates/{rateId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // 14. ZERO-TRUST: FECHO PADRÃO DE SEGURANÇA (Default Deny)
    // ─────────────────────────────────────────────────────────────
    // Bloqueia qualquer coleção ou rota não expressamente permitida acima
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
