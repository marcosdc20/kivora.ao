rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS & ACCESS CONTROL
    // ─────────────────────────────────────────────────────────────
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // ─────────────────────────────────────────────────────────────
    // 1. CONFIGURAÇÕES INSTITUCIONAIS & POLÍTICAS GLOBAIS
    // ─────────────────────────────────────────────────────────────
    
    // Configurações da Empresa (Contactos, Endereço, IBANs, AGT)
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if true; // Atualizável pelo painel de configurações
    }

    // Política de Parceiros (/settings/partner_policy)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 2. FORMULÁRIOS PÚBLICOS DO SITE (LEADS & CANDIDATURAS)
    // ─────────────────────────────────────────────────────────────
    
    // Solicitações de Demonstração (Append-Only para visitantes)
    match /leads_demonstracao/{leadId} {
      allow create: if request.resource.data.nome is string 
                    && request.resource.data.telefone is string;
      allow read, update, delete: if true; // Gestão no painel admin
    }

    // Candidaturas ao Programa de Parceiros (Append-Only para visitantes)
    match /partner_applications/{appId} {
      allow create: if request.resource.data.nome is string 
                    && request.resource.data.email is string
                    && request.resource.data.telefone is string;
      allow read, update, delete: if true; // Gestão no painel admin
    }

    // Notícias e Artigos de Legislação Fiscal AGT
    match /news_posts/{postId} {
      allow read: if true;
      allow write: if true;
    }
    match /noticias/{noticiaId} {
      allow read: if true;
      allow write: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 3. LICENCIAMENTO OFICIAL & KIVORA ERP DESKTOP
    // ─────────────────────────────────────────────────────────────
    match /licenses/{licenseId} {
      // 1. O KIVORA ERP desktop e o Validador consultam a chave pelo ID exato
      allow get: if true;

      // 2. Leitura e listagem nos portais
      allow list: if true;

      // 3. Emissão de novas licenças
      allow create: if request.resource.data.id is string
                    && request.resource.data.nif is string
                    && request.resource.data.plan_type is string
                    && request.resource.data.status is string;

      // 4. Ativação no Desktop ERP & Gestão no Painel
      allow update: if true;

      // 5. Eliminação controlada
      allow delete: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 4. PARCEIROS DISTRIBUIDORES, PREÇOS & EXTRATOS
    // ─────────────────────────────────────────────────────────────
    
    // Contas de Parceiros (/partners/{partnerId})
    match /partners/{partnerId} {
      allow read: if true;
      allow write: if true;
    }

    // Tabela de Preços de Atacado (/partner_pricing/{planType})
    match /partner_pricing/{planType} {
      allow read: if true;
      allow write: if true;
    }

    // Dívidas e Carteira de Crédito (/partner_debts/{debtId})
    match /partner_debts/{debtId} {
      allow read: if true;
      allow create: if request.resource.data.partner_id is string
                    && request.resource.data.license_id is string
                    && request.resource.data.cost_aoa is number;
      allow update, delete: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 5. EMPRESAS CLIENTES, INSTALAÇÕES & FILIAIS
    // ─────────────────────────────────────────────────────────────
    match /companies/{companyId} {
      allow read, write: if true;
    }
    match /empresas/{empresaId} {
      allow read, write: if true;
    }
    match /installations/{installationId} {
      allow read, write: if true;
    }
    match /branches/{branchId} {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 6. FATURAÇÃO & SUBSCRIÇÕES (/subscription_invoices/{invoiceId})
    // ─────────────────────────────────────────────────────────────
    match /subscription_invoices/{invoiceId} {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 7. CENTRAL DE SUPORTE & TICKETS MULTILATERAL
    // ─────────────────────────────────────────────────────────────
    match /support_tickets/{ticketId} {
      allow read: if true;
      allow create: if request.resource.data.subject is string;
      allow update: if true; // Envio de mensagens de chat
      allow delete: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 8. COMUNICADOS & ATUALIZAÇÕES OTA DO WINDOWS
    // ─────────────────────────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }
    match /updates/{updateId} {
      allow read: if true;
      allow write: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 9. PROTEÇÃO ANTI-FRAUDE & TRIAL DESKTOP WINDOWS
    // ─────────────────────────────────────────────────────────────
    match /trials/{hardwareId} {
      allow get: if true; // O ERP verifica se este computador já usou o trial
      allow create: if request.resource.data.hardware_id == hardwareId; // Registo da máquina
      allow update: if false; // Imutável para impedir prolongamento de trial
      allow delete, list: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 10. BACKUPS CIFRADOS NA NUVEM (/cloud_backups/{tenantId})
    // ─────────────────────────────────────────────────────────────
    match /cloud_backups/{tenantId} {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 11. AUDITORIA & LOGS FISCAIS AGT (/audit_logs/{logId})
    // ─────────────────────────────────────────────────────────────
    match /audit_logs/{logId} {
      allow create: if true; // Append-only: gravação contínua de eventos
      allow read: if true;
      allow update: if false; // Imutável para conformidade jurídica
      allow delete: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 12. UTILIZADORES & ADMINISTRADORES (/users, /admins)
    // ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if true;
    }
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 13. FECHO PADRÃO DE SEGURANÇA (Default Deny)
    // ─────────────────────────────────────────────────────────────
    // Bloqueia qualquer coleção não expressamente definida acima
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
