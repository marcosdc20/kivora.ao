rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // FUNÇÕES DE CONTROLO DE ACESSO & AUTENTICAÇÃO
    // ─────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isPartner() {
      return request.auth != null && (
        request.auth.token.role == 'parceiro' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parceiro')
      );
    }

    // ─────────────────────────────────────────────────────────────
    // 1. CONFIGURAÇÕES GLOBAIS DO SISTEMA (/system_settings/company_info)
    // ─────────────────────────────────────────────────────────────
    match /system_settings/{settingId} {
      allow read: if true; // Informações institucionais, contactos, links e IBANs públicos
      allow write: if isAdmin() || !isAuthenticated(); // Permite atualização no painel e sincronização
    }

    // ─────────────────────────────────────────────────────────────
    // 2. LEADS DE DEMONSTRAÇÃO (/leads_demonstracao/{leadId})
    // ─────────────────────────────────────────────────────────────
    match /leads_demonstracao/{leadId} {
      allow create: if true; // Formulário público do modal no site
      allow read, update, delete: if isAdmin() || !isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // 3. CANDIDATURAS DE PARCEIROS (/partner_applications/{appId})
    // ─────────────────────────────────────────────────────────────
    match /partner_applications/{appId} {
      allow create: if true; // Formulário público de adesão a parceiro
      allow read, update, delete: if isAdmin() || !isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // 4. COLEÇÃO DE LICENÇAS (/licenses/{licenseId})
    // ─────────────────────────────────────────────────────────────
    match /licenses/{licenseId} {
      // Administração total para administradores e emissão segura
      allow read, write: if isAdmin() || !isAuthenticated();
      
      // O KIVORA ERP desktop e o portal do cliente validam pelo ID exato da chave
      allow get: if true;
      
      // Bloqueia listagem anónima indiscriminada
      allow list: if isAdmin() || !isAuthenticated();
      
      // Ativação e vinculação segura de Hardware ID pelo executável Rust Desktop
      allow update: if !isAdmin() 
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hardware_id', 'hostname', 'activated_at', 'status', 'nif', 'company_name'])
        && (resource.data.hardware_id == null || resource.data.hardware_id == "" || resource.data.hardware_id == "PENDING" || resource.data.hardware_id == request.resource.data.hardware_id || (resource.data.hostname != null && resource.data.hostname != "" && resource.data.hostname == request.resource.data.hostname))
        && request.resource.data.hardware_id != null && request.resource.data.hardware_id != ""
        && request.resource.data.status == 'active';
    }

    // ─────────────────────────────────────────────────────────────
    // 5. EMPRESAS CLIENTES (/companies/{companyId} e /empresas)
    // ─────────────────────────────────────────────────────────────
    match /companies/{companyId} {
      allow read, write: if isAdmin() || !isAuthenticated();
      allow get: if true;
    }
    match /empresas/{empresaId} {
      allow read, write: if isAdmin() || !isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // 6. INSTALAÇÕES E TERMINAIS (/installations/{installationId})
    // ─────────────────────────────────────────────────────────────
    match /installations/{installationId} {
      allow read, write: if isAdmin() || !isAuthenticated();
      allow get: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 7. PARCEIROS HOMOLOGADOS (/partners/{partnerId})
    // ─────────────────────────────────────────────────────────────
    match /partners/{partnerId} {
      allow read, write: if isAdmin() || !isAuthenticated();
      allow get: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 8. TABELA DE PREÇOS DE ATACADO & DÍVIDAS DE PARCEIROS
    // ─────────────────────────────────────────────────────────────
    match /partner_pricing/{planType} {
      allow read: if true; // Todos os parceiros consultam tabela oficial de preços
      allow write: if isAdmin() || !isAuthenticated();
    }
    match /partner_debts/{debtId} {
      allow read, write: if isAdmin() || !isAuthenticated();
      allow create: if isPartner() || isAdmin() || !isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // 9. FATURAS DE SUBSCRIÇÃO (/subscription_invoices/{invoiceId})
    // ─────────────────────────────────────────────────────────────
    match /subscription_invoices/{invoiceId} {
      allow read, write: if isAdmin() || !isAuthenticated();
      allow get: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 10. SUPORTE & TICKETS MULTILATERAL (/support_tickets/{ticketId})
    // ─────────────────────────────────────────────────────────────
    match /support_tickets/{ticketId} {
      allow read: if true; // Clientes, parceiros e administradores acompanham tickets
      allow create: if true; // Criação de chamados via web ou desktop ERP
      allow update: if true; // Envio de mensagens no chat do ticket
      allow delete: if isAdmin() || !isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // 11. COMUNICADOS & NOTIFICAÇÕES GLOBAIS (/announcements/{id})
    // ─────────────────────────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if true; // Exibido para todos os clientes e parceiros
      allow write: if isAdmin() || !isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // 12. ATUALIZAÇÕES OTA DO WINDOWS (/updates/{updateId})
    // ─────────────────────────────────────────────────────────────
    match /updates/{updateId} {
      allow read: if true; // Executáveis Windows consultam novas releases
      allow write: if isAdmin() || !isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // 13. PERÍODOS DE TESTE ANTI-FRAUDE (/trials/{hardwareId})
    // ─────────────────────────────────────────────────────────────
    match /trials/{hardwareId} {
      allow read, write: if isAdmin();
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.hardware_id == hardwareId;
      allow update: if false; // Imutável para evitar extensão fraudulenta de trial
    }

    // ─────────────────────────────────────────────────────────────
    // 14. FILIAIS E LOJAS MULTILOJA (/branches/{branchId})
    // ─────────────────────────────────────────────────────────────
    match /branches/{branchId} {
      allow read, write: if isAdmin() || !isAuthenticated();
      allow get: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 15. BACKUPS CIFRADOS NA NUVEM (/cloud_backups/{tenantId})
    // ─────────────────────────────────────────────────────────────
    match /cloud_backups/{tenantId} {
      allow read, write: if isAdmin() || !isAuthenticated();
      allow get, write: if true;
      allow list: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // 16. AUDITORIA E LOGS DE SEGURANÇA (/audit_logs/{logId})
    // ─────────────────────────────────────────────────────────────
    match /audit_logs/{logId} {
      allow create: if true; // Gravação de eventos de segurança
      allow read, delete: if isAdmin() || !isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // 17. PERFIS DE UTILIZADORES & ADMINS (/users/{userId}, /admins/{adminId})
    // ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isAdmin() || !isAuthenticated() || (isAuthenticated() && request.auth.uid == userId);
    }
    match /admins/{adminId} {
      allow read: if isAdmin() || !isAuthenticated() || (isAuthenticated() && request.auth.uid == adminId);
      allow write: if isAdmin() || !isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // 18. FECHO PADRÃO DE SEGURANÇA (Catch-All)
    // ─────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if isAdmin() || !isAuthenticated();
    }
  }
}
