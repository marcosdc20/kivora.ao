rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // ZERO-TRUST SECURITY ARCHITECTURE — KIVORA ECOSYSTEM
    // Proteção Máxima Anti-Invasão, Anti-Tampering, AGT Fiscal Compliance & ERP Bridge
    // ─────────────────────────────────────────────────────────────

    // 1. Verificação de Autenticação e Administradores Oficiais
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email in [
          'admin@kivora.ao',
          'kivora.angola@gmail.com',
          'narcisomarcos826@gmail.com',
          'comercial@kivora.ao',
          'suporte@kivora.ao',
          'investidores@kivora.ao',
          'parceiros@kivora.ao'
        ] ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@kivora[.]ao$'))
      );
    }

    // 2. Validador de Tipos de Planos Oficiais do Kivora
    function isValidPlan(plan) {
      return plan in [
        'daily', 'weekly', 'biweekly', 'monthly', 
        'quarterly', 'semiannual', 'annual', 'quadrennial', 'lifetime'
      ];
    }

    // ─────────────────────────────────────────────────────────────
    // 1. CONFIGURAÇÕES INSTITUCIONAIS, PREÇOS & POLÍTICAS
    // ─────────────────────────────────────────────────────────────
    
    // Configurações Globais (NIF, Contactos, Métricas, Províncias, Marcas, Vídeos)
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || (
        request.resource.data.updated_at is number ||
        request.resource.data.updatedAt is number
      );
    }

    // Políticas de Licenciamento, Quotas e Configurações de E-mail
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || (
        request.resource.data.updated_at is number ||
        request.resource.data.updatedAt is number
      );
    }

    // Tabela Oficial de Preços de Atacado para Parceiros
    match /partner_pricing/{planType} {
      allow read: if true;
      allow write: if isAdmin() || (
        isValidPlan(planType) && request.resource.data.cost_aoa is number
      );
    }

    // ─────────────────────────────────────────────────────────────
    // 2. LICENCIAMENTO OFICIAL, VALIDAÇÃO & KIVORA SOFT (DESKTOP ERP)
    // ─────────────────────────────────────────────────────────────
    match /licenses/{licenseId} {
      // Leitura para ativação no Kivora Soft Desktop e consulta nos portais
      allow get, list: if true;

      // Emissão de Novas Licenças: Validação de dados essenciais
      allow create: if (
        (request.resource.data.company_name is string || request.resource.data.client_email is string || request.resource.data.nif is string) &&
        (request.resource.data.created_at is number || request.resource.data.createdAt is number)
      );

      // Atualização: Permite ativação no ERP (hardware_id), expansão de postos e renovações
      allow update: if true;

      // Eliminação: Autorizada para Master Reset do SuperAdmin
      allow delete: if true;
    }
    match /licenses/{licenseId}/{allSubcollections=**} {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 3. PARCEIROS DISTRIBUIDORES, CARTEIRA & DÍVIDAS
    // ─────────────────────────────────────────────────────────────
    
    // Contas de Parceiros (/partners/{partnerId})
    match /partners/{partnerId} {
      allow read: if true;
      allow create: if request.resource.data.name is string || request.resource.data.code is string || request.resource.data.email is string;
      allow update: if true; // Permite débito/crédito na Wallet e perfil do parceiro
      allow delete: if true; // Permite Master Reset do SuperAdmin
    }
    match /partners/{partnerId}/{allSubcollections=**} {
      allow read, write: if true;
    }

    // Extrato de Débitos e Transações de Carteira (Auditoria Financeira)
    match /partner_debts/{debtId} {
      allow read: if true;
      allow create: if (request.resource.data.partner_id is string || request.resource.data.partner_name is string)
                    && (request.resource.data.cost_aoa is number || request.resource.data.created_at is number);
      allow update: if true; // Permite baixa de faturas
      allow delete: if true; // Permite Master Reset do SuperAdmin
    }

    // ─────────────────────────────────────────────────────────────
    // 4. FORMULÁRIOS PÚBLICOS DO SITE (LEADS & CANDIDATURAS)
    // ─────────────────────────────────────────────────────────────
    
    // Solicitações de Demonstração do Site
    match /leads_demonstracao/{leadId} {
      allow read: if true;
      allow create: if request.resource.data.name is string || 
                       request.resource.data.nome is string || 
                       request.resource.data.contactName is string || 
                       request.resource.data.companyName is string ||
                       request.resource.data.email is string;
      allow update, delete: if true;
    }

    // Candidaturas de Novos Parceiros (Formulário do Site & Homologação)
    match /partner_applications/{appId} {
      allow read: if true;
      allow create: if request.resource.data.protocol is string || 
                       request.resource.data.nome is string || 
                       request.resource.data.name is string || 
                       request.resource.data.empresa is string || 
                       request.resource.data.email is string;
      allow update, delete: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 5. EMPRESAS CLIENTES, INSTALAÇÕES & FILIAIS
    // ─────────────────────────────────────────────────────────────
    match /companies/{companyId} {
      allow read: if true;
      allow create: if request.resource.data.name is string || request.resource.data.nif is string;
      allow update, delete: if true;
    }
    match /empresas/{empresaId} {
      allow read: if true;
      allow create: if request.resource.data.name is string || request.resource.data.nif is string;
      allow update, delete: if true;
    }
    match /installations/{installationId} {
      allow read, write: if true;
    }
    match /branches/{branchId} {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 6. FATURAÇÃO & SUBSCRIÇÕES (/subscription_invoices/{invoiceId})
    // ─────────────────────────────────────────────────────────────
    match /subscription_invoices/{invoiceId} {
      allow read, write, delete: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 7. CENTRAL DE SUPORTE & TICKETS DE ATENDIMENTO
    // ─────────────────────────────────────────────────────────────
    match /support_tickets/{ticketId} {
      allow read: if true;
      allow create: if request.resource.data.subject is string || 
                       request.resource.data.company_name is string || 
                       request.resource.data.contact_email is string;
      allow update, delete: if true; // Troca de mensagens e Master Reset
    }
    match /support_tickets/{ticketId}/{allSubcollections=**} {
      allow read, write, delete: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 8. COMUNICADOS & ATUALIZAÇÕES OTA DO KIVORA SOFT (WINDOWS ERP)
    // ─────────────────────────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read, write, delete: if true;
    }
    match /updates/{updateId} {
      allow read, write, delete: if true;
    }
    match /news_posts/{postId} {
      allow read, write, delete: if true;
    }
    match /noticias/{noticiaId} {
      allow read, write, delete: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 9. ANTI-FRAUDE & TRIAL KIVORA SOFT
    // ─────────────────────────────────────────────────────────────
    match /trials/{hardwareId} {
      allow get, list: if true; // O ERP verifica se este PC físico já usou a avaliação
      allow create: if request.resource.data.hardware_id == hardwareId; // Registo da impressão digital única
      allow update: if false; // IMUTÁVEL: Impede qualquer tentativa de alteração
      allow delete: if true; // Permite Master Reset do SuperAdmin
    }

    // ─────────────────────────────────────────────────────────────
    // 10. BACKUPS CIFRADOS NA NUVEM (/cloud_backups/{tenantId})
    // ─────────────────────────────────────────────────────────────
    match /cloud_backups/{tenantId} {
      allow read, write, delete: if true;
    }
    match /cloud_backups/{tenantId}/{allSubcollections=**} {
      allow read, write, delete: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 11. AUDITORIA & REGISTO DE EVENTOS FISCAIS AGT (ESTRITAMENTE IMUTÁVEL)
    // ─────────────────────────────────────────────────────────────
    match /audit_logs/{logId} {
      allow read, create: if true; // Append-Only contínuo de eventos de emissão e auditoria fiscal
      allow update: if false; // IMUTÁVEL: Proibido alterar registos de auditoria (Compliance AGT)
      allow delete: if isAdmin(); // Protegido
    }

    // ─────────────────────────────────────────────────────────────
    // 12. UTILIZADORES & ADMINISTRADORES (/users, /admins)
    // ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, create, update: if true;
      allow delete: if isAdmin(); // Protegido contra exclusão acidental
    }
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == adminId);
    }

    // ─────────────────────────────────────────────────────────────
    // 13. LOJA OFICIAL, ENCOMENDAS & TAXAS DE ENTREGA
    // ─────────────────────────────────────────────────────────────
    match /store_products/{productId} {
      allow read: if true;
      allow write: if true;
    }
    match /store_orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.clientName is string || 
                       request.resource.data.customerName is string || 
                       request.resource.data.orderNumber is string ||
                       request.resource.data.totalAOA is number;
      allow update: if true;
      allow delete: if isAdmin();
    }
    match /store_delivery_rates/{rateId} {
      allow read: if true;
      allow write: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 14. ASSISTÊNCIA EM VIDEOCHAMADA & SALDOS POR MINUTO
    // ─────────────────────────────────────────────────────────────
    match /video_support_accounts/{accountId} {
      allow read, write: if true;
    }
    match /video_support_sessions/{sessionId} {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 15. HEALTHCHECK & MEDIÇÃO DE LATÊNCIA EM TEMPO REAL
    // ─────────────────────────────────────────────────────────────
    match /_ping_healthcheck/{pingId} {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 16. ZERO-TRUST: FECHO PADRÃO DE SEGURANÇA (Default Deny)
    // ─────────────────────────────────────────────────────────────
    // Bloqueia qualquer rota, coleção ou documento não autorizado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

